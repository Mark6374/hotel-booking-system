# ---- database (required)
DB_NAME=hotel_booking
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- everything below is OPTIONAL for local development.
# ---- For production set at least the lines marked (production).
# DJANGO_DEBUG=0                           # (production) 0 turns the secure settings on
# DJANGO_SECRET_KEY=                       # (production) 50+ random characters, keep it secret
# DJANGO_ALLOWED_HOSTS=hotel.example.com   # (production) comma separated
# DJANGO_CSRF_TRUSTED_ORIGINS=https://hotel.example.com   # (production) the admin is served from here
# CORS_ALLOWED_ORIGINS=https://www.example.com             # (production) where the React site lives
# FRONTEND_URL=https://www.example.com     # links in e-mails and "View site" in the admin
# DJANGO_ADMIN_URL=staff-9f3k2/            # hide the admin from /admin/ (default admin/)
# DJANGO_TIME_ZONE=UTC                     # the hotel's local zone, e.g. Europe/London; used for "today"
# DJANGO_BEHIND_PROXY=1                    # nginx / load balancer terminates HTTPS
# DJANGO_SSL_REDIRECT=1                    # default 1 when DJANGO_DEBUG=0
# DJANGO_HSTS_SECONDS=31536000             # default 1 year when DJANGO_DEBUG=0
# REDIS_URL=redis://127.0.0.1:6379/0       # (production, more than one process) chat messages between processes; needs channels-redis
# MEDIA_ROOT=/var/lib/hotel/media          # where profile photos are stored (default backend/media); keep it between deploys
# ---- AI assistant in the chat widget (AI_ASSISTANT.md). One key is enough; without a key it answers 503.
# GROQ_API_KEY=gsk_...                     # free key from console.groq.com
# ANTHROPIC_API_KEY=sk-ant-...             # or Claude (paid)
# ASSISTANT_PROVIDER=groq                  # optional: groq | anthropic (default: whichever key is set)
# ASSISTANT_MODEL=openai/gpt-oss-120b      # optional; Claude default is claude-haiku-5-5
# DB_CONN_MAX_AGE=60
# DJANGO_LOG_LEVEL=INFO
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=no-reply@junipercourt.example
